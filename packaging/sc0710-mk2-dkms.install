post_install() {
    cat <<'EOF'
sc0710-mk2-dkms: the module is NOT loaded automatically.
  /etc/modprobe.d/sc0710-blacklist.conf keeps it from loading at boot.
  Check the build:  dkms status sc0710
  Load:             sudo modprobe sc0710
  Emergency:        add module_blacklist=sc0710 to the kernel command line
EOF
}

post_upgrade() {
    post_install
}
